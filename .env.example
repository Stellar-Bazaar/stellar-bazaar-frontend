# Stellar Bazaar Frontend Environment Configuration
# Copy this template to .env or .env.local for development and deployment.

# Target Stellar Network (TESTNET or PUBLIC)
VITE_STELLAR_NETWORK="TESTNET"

# Network Cryptographic Passphrase
